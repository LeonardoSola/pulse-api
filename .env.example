# Copy to .env and adjust. docker-compose.yaml reads this file too.

# [App]
# development (debug logs, error details in responses) or production
ENV=development

# [Server]
SERVER_PORT=8080
# Required. Generate one with: openssl rand -hex 32
API_KEY=

# [Database]
# docker compose overrides DB_HOST with the postgres service name.
DB_HOST=localhost
DB_PORT=5432
DB_USER=pulse
DB_PASS=change-me
DB_NAME=pulse_api
DB_SSL_MODE=disable
# Alternatively, a full connection string (takes precedence over DB_*):
# DB_CONNECTION_STRING=postgres://pulse:change-me@localhost:5432/pulse_api?sslmode=disable

# [RabbitMQ] (optional)
# With docker compose, also start the broker: docker compose --profile rabbitmq up -d
RABBITMQ_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=pulse-api
# Alternatively, a full URL (takes precedence over RABBITMQ_*):
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/
